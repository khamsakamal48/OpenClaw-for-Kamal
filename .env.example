###############################################################################
# OpenClaw Environment Configuration
# Copy this file to .env and fill in your values:  cp .env.example .env
# Then lock down permissions:                       chmod 600 .env
###############################################################################

# ---------------------------------------------------------------------------
# Container Image
# ---------------------------------------------------------------------------
# Pre-built image from the registry. Change the tag for a specific version.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest

# ---------------------------------------------------------------------------
# AI Model Provider
# ---------------------------------------------------------------------------
# OpenRouter — provides access to free and paid models.
# Get your key at https://openrouter.ai/keys
# This is OPTIONAL here — you can also configure it later in the OpenClaw
# web UI (Settings > Models) or in the workspace YAML config file at
# ./openclaw-config/workspace/config.yaml
OPENROUTER_API_KEY=

# Uncomment if you also want direct provider access:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Timezone
# ---------------------------------------------------------------------------
# IANA timezone for the container. List: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=UTC

# ---------------------------------------------------------------------------
# OpenClaw Feature Flags
# ---------------------------------------------------------------------------
# Enable sandbox mode (requires Docker socket mount — security risk on VPS).
# Leave disabled unless you specifically need container-in-container execution.
OPENCLAW_SANDBOX=false

# Pre-install extension dependencies (space-separated directory names)
# OPENCLAW_EXTENSIONS=

# Extra apt packages to install in the container (space-separated)
# OPENCLAW_DOCKER_APT_PACKAGES=

# ---------------------------------------------------------------------------
# Channel Tokens (configure the channels you plan to use)
# ---------------------------------------------------------------------------

# Telegram — get a bot token from @BotFather on Telegram
# TELEGRAM_BOT_TOKEN=

# WhatsApp — uses Baileys (no official API key needed).
# Pairing happens via QR code on first connect through the web UI.

# MS Teams — requires Azure AD app registration.
# See: https://docs.openclaw.ai/channels/teams
# TEAMS_APP_ID=
# TEAMS_APP_PASSWORD=
# TEAMS_TENANT_ID=
